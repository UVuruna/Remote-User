<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice input (owner 2026-08-04): the Mic button listens directly via
         SpeechRecognizer — asked at first use, once. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Network-change callbacks: the shell re-resolves the address the
         moment connectivity returns (flaky foreign Wi-Fi) — normal
         permission, granted automatically, no user prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ gates every notification behind a runtime grant; the app
         asks for it once at START, while the owner is looking at the app —
         asking when the first notice arrives spent that notice on the dialog,
         and in the background the dialog cannot even appear (owner 2026-08-06). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The waiting channel (owner decree 2026-08-07): a foreground service
         holds one idle socket to the PC so a notice reaches this phone while
         the app is closed. Without a foreground service Android kills the
         process — and the socket with it — within minutes.

         TYPE = connectedDevice, and it is the honest one: this service exists
         solely to hold a network connection to ONE specific paired device,
         the owner's own PC, which is precisely what that type describes.
         `dataSync` would be the lazy pick and is wrong twice over — nothing
         is being synchronised, and Android 15 deprecated it with a six-hour
         cap that would kill this at the end of every working day.
         `specialUse` is the escape hatch for things with no honest type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- The companion permission the `connectedDevice` TYPE requires (live
         failure 2026-08-08 — the app would not start at all on v0.0.093).
         Since Android 14 that type is only allowed to a process that also
         holds one of BLUETOOTH_CONNECT / BLUETOOTH_ADVERTISE / BLUETOOTH_SCAN
         / CHANGE_NETWORK_STATE / CHANGE_WIFI_STATE /
         CHANGE_WIFI_MULTICAST_STATE / NFC / TRANSMIT_IR / UWB_RANGING / a USB
         grant; holding NONE makes startForeground throw SecurityException in
         the SERVICE's onCreate — which is not on the caller's stack, so the
         try/catch around startForegroundService never sees it and the whole
         process dies one second after launch, every launch.
         CHANGE_NETWORK_STATE is the honest one of that list for a service
         whose entire job is a network connection to one paired device, and it
         is a NORMAL permission: granted at install, the user is never asked.
         Never remove it while NoticeService declares `connectedDevice`
         (gate: tests/test_notice_channel.py). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Doze can defer an unexempted app's network traffic while the device
         is idle, which for us means a notice sitting on the wire until the
         phone next wakes — the exact complaint the service exists to fix.
         Only the USER can grant this; the app explains it in the page and
         opens the system dialog, and never pretends to have it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Package visibility (Android 11+): without this, the system pretends
         Tailscale is not installed, so the error card could never tell
         "not installed" from "installed but off" — the two states whose
         guidance differs completely (install it vs. flip its switch).
         The RecognitionService entry is the same story for voice input:
         without it, SpeechRecognizer reports "not available" on Android 11+. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- The server speaks plain http on the LAN / Tailscale private network —
         cleartext must be allowed (Android blocks it by default since 9). -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteUser"
        tools:targetApi="26">

        <!-- singleTask: the funnel launches us from the BROWSER — without it
             the app would open inside Chrome's task (wrong Recents entry,
             weird back stack). -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The install funnel's "Open the app" hands over the pairing
                 URL (token included) as remoteuser://pair?url=… — the app
                 connects with one tap, nothing typed or scanned. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="remoteuser" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- configChanges: rotating must NOT recreate the WebView — the live
             H.264 stream and WebSocket session survive rotation instead. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />

        <!-- The waiting state (owner decree 2026-08-07): "android strana čeka
             signal, ne prima ništa od kompjutera, ali ostane u stanju čekanja
             signala". Not exported — nothing but this app may start it. -->
        <service
            android:name=".NoticeService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Camera capture target (the Attach set's Camera button): the shot
             is written into this app's cache and handed to the page — no
             storage permission, nothing left in the user's gallery. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
